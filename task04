#include <stdio.h>

int main() {
    int marks[4][2];
    int i, j;
    
   
    int highMid, highFinal, highOverall;
    int lowMid, lowFinal, lowOverall;
    float sumMid = 0, sumFinal = 0;
    float avgMid, avgFinal;


    printf("Enter Exam Marks for 4 Students\n");
    for (i = 0; i < 4; i++) {
        printf("\nStudent %d:\n", i + 1);
        
        
        printf("  Enter Mid marks: ");
        scanf("%d", &marks[i][0]);
        
   
        printf("  Enter Final marks: ");
        scanf("%d", &marks[i][1]);
    }

    highMid = lowMid = marks[0][0];
    highFinal = lowFinal = marks[0][1];
    highOverall = (marks[0][0] > marks[0][1]) ? marks[0][0] : marks[0][1];
    lowOverall = (marks[0][0] < marks[0][1]) ? marks[0][0] : marks[0][1];

    for (i = 0; i < 4; i++) {
       
        sumMid += marks[i][0];
        sumFinal += marks[i][1];

        if (marks[i][0] > highMid) highMid = marks[i][0];
        if (marks[i][0] < lowMid) lowMid = marks[i][0];

        if (marks[i][1] > highFinal) highFinal = marks[i][1];
        if (marks[i][1] < lowFinal) lowFinal = marks[i][1];

        if (marks[i][0] > highOverall) highOverall = marks[i][0];
        if (marks[i][1] > highOverall) highOverall = marks[i][1];
        
        if (marks[i][0] < lowOverall) lowOverall = marks[i][0];
        if (marks[i][1] < lowOverall) lowOverall = marks[i][1];
    }

   
    avgMid = sumMid / 4.0;
    avgFinal = sumFinal / 4.0;

    
    

    printf("1. TOTAL MARKS PER STUDENT:\n");
    
    for (i = 0; i < 4; i++) {
        int total = marks[i][0] + marks[i][1];
        printf("Student %d -> Mid: %d, Final: %d | Total: %d\n", 
               i + 1, marks[i][0], marks[i][1], total);
    }

    printf("highest and lowest:\n");
    
    printf("Mid Exam Highest: %d | Lowest: %d\n", highMid, lowMid);
    printf("Final Exam Highest: %d | Lowest: %d\n", highFinal, lowFinal);
    printf("Overall Highest: %d | Lowest: %d\n", highOverall, lowOverall);

    // 
    printf("averages\n");
  
    printf("Average Mid Marks:   %.2f\n", avgMid);
    printf("Average Final Marks: %.2f\n", avgFinal);

}
